# Puerto del servidor GrillMaster API
PORT=8787

# Origen(es) permitidos para CORS (separados por coma). Usa "*" en desarrollo.
CORS_ORIGIN=http://localhost:5173

# Proveedor de IA: "mock" no requiere ninguna clave y es el valor por defecto.
AI_PROVIDER=mock

# Claves de proveedores reales de IA (NUNCA se exponen al frontend).
# AI_API_KEY=
# AI_MODEL=
